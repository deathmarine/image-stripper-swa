{
  "name": "image-strip-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "start": "npm run build && func start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@azure/functions": "^4.11.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}